{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Portfolio Configuration",
  "description": "Master configuration file for the portfolio. Edit works, descriptions, images, and content directly here.",
  "type": "object",
  "required": ["works", "author", "socials", "site"],
  "properties": {
    "works": {
      "type": "array",
      "description": "List of portfolio projects / case studies",
      "items": {
        "type": "object",
        "required": ["slug", "title", "description"],
        "properties": {
          "slug": {
            "type": "string",
            "description": "Unique URL slug and directory name under projects/"
          },
          "title": {
            "type": "string",
            "description": "Project title displayed on cards and detail page"
          },
          "category": {
            "type": "string",
            "description": "Category / Discipline (e.g. 'Retail & Hospitality')"
          },
          "year": {
            "type": "string",
            "description": "Year completed (e.g. '2023')"
          },
          "client": {
            "type": "string",
            "description": "Client name or studio"
          },
          "location": {
            "type": "string",
            "description": "City or country"
          },
          "description": {
            "type": "string",
            "description": "Full case study story / overview paragraph displayed on the project page"
          },
          "heroImage": {
            "type": "string",
            "description": "Hero banner image URL (Recommended: 2000 x 1333 px, 3:2 Landscape)"
          },
          "galleryImages": {
            "type": "array",
            "items": { "type": "string" },
            "description": "List of gallery image URLs"
          }
        }
      }
    },
    "author": {
      "type": "object",
      "required": ["name", "email"],
      "properties": {
        "name": { "type": "string" },
        "shortName": { "type": "string" },
        "title": { "type": "string" },
        "tagline": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "location": { "type": "string" }
      }
    },
    "socials": {
      "type": "object",
      "properties": {
        "linkedin": { "type": "string", "format": "uri" },
        "github": { "type": "string", "format": "uri" },
        "instagram": { "type": "string", "format": "uri" }
      }
    },
    "site": {
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "domain": { "type": "string", "format": "uri" },
        "description": { "type": "string" }
      }
    },
    "about": {
      "type": "object",
      "properties": {
        "headline": { "type": "string" },
        "subheadline": { "type": "string" },
        "bioParagraphs": {
          "type": "array",
          "items": { "type": "string" }
        },
        "profileImage": { "type": "string" }
      }
    },
    "services": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "slug": { "type": "string" },
          "title": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    },
    "imageDimensionsReference": {
      "type": "object"
    }
  }
}
